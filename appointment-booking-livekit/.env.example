# LiveKit (create a free project at https://cloud.livekit.io, or self-host)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Claude — the receptionist's brain (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Speech-to-text (https://deepgram.com)
DEEPGRAM_API_KEY=

# Text-to-speech (https://cartesia.ai)
CARTESIA_API_KEY=

# --- Google Calendar -------------------------------------------------------
# oauth            -> run `python scripts/authorize_google.py` once (personal Gmail or Workspace)
# service_account  -> share the calendar with the service account's email
GOOGLE_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_SECRET_FILE=credentials/client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=credentials/token.json
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# "primary" or a calendar id like abc123@group.calendar.google.com
GOOGLE_CALENDAR_ID=primary
# Set to false in service_account mode (attendee invites need domain-wide delegation)
CALENDAR_INVITE_ATTENDEES=true

# --- Booking rules ---------------------------------------------------------
BUSINESS_NAME=Northside Dental
BUSINESS_TIMEZONE=America/New_York
BUSINESS_OPEN=09:00
BUSINESS_CLOSE=17:00
BUSINESS_WEEKDAYS=1,2,3,4,5
SLOT_MINUTES=30
APPOINTMENT_MINUTES=30
MIN_LEAD_MINUTES=60
MAX_DAYS_AHEAD=30

# Optional: override the Claude model. Default is claude-opus-5. For lower
# latency/cost on voice, try claude-sonnet-5 or claude-haiku-4-5.
# BOOKING_MODEL=claude-opus-5
