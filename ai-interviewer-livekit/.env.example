# LiveKit (create a free project at https://cloud.livekit.io, or self-host)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Claude — the interviewer's brain (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Speech-to-text (https://deepgram.com)
DEEPGRAM_API_KEY=

# Text-to-speech (https://cartesia.ai)
CARTESIA_API_KEY=

# Optional: override the Claude model the interviewer uses.
# Default is claude-opus-4-8. For lower latency/cost on voice, try
# claude-sonnet-4-6 or claude-haiku-4-5.
# INTERVIEWER_MODEL=claude-opus-4-8
